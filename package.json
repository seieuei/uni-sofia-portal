{
  "name": "uni-sofia-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bash scripts/start.sh",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "start:prod": "bash scripts/start.sh",
    "template:5.2": "tsx scripts/build-5-2-template.ts",
    "template:catalog": "python3 scripts/build-official-templates.py",
    "prebuild": "tsx scripts/build-5-2-template.ts && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "docxtemplater": "^3.69.3",
    "jose": "^6.2.12",
    "js-cookie": "^3.0.8",
    "next": "14.2.35",
    "pizzip": "^3.2.0",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.23.13",
    "zod": "^4.6.2",
    "tailwindcss": "^3.4.1",
    "postcss": "^8",
    "typescript": "^5",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-cookie": "^3.0.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
