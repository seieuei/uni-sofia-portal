generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Faculty {
  id        String         @id @default(cuid())
  code      String         @unique
  nameBg    String
  nameEn    String
  shortBg   String
  shortEn   String
  forms     FormTemplate[]
  rules     RoutingRule[]
  profiles  Profile[]
  cases     Case[]
  programs  Program[]
  createdAt DateTime       @default(now())
}

model Office {
  id            String       @id @default(cuid())
  code          String       @unique
  nameBg        String
  nameEn        String
  descriptionBg String?
  descriptionEn String?
  emailSim      String
  rules         RoutingRule[]
  submissions   Submission[]
  createdAt     DateTime     @default(now())
}

model FormTemplate {
  id            String         @id @default(cuid())
  slug          String         @unique
  titleBg       String
  titleEn       String
  descriptionBg String
  descriptionEn String
  category      String
  fieldsJson    String
  roles         String
  facultyId     String?
  faculty       Faculty?       @relation(fields: [facultyId], references: [id])
  satireNoteBg  String?
  satireNoteEn  String?
  rules         RoutingRule[]
  submissions   Submission[]
  createdAt     DateTime       @default(now())
}

model RoutingRule {
  id        String       @id @default(cuid())
  formId    String
  form      FormTemplate @relation(fields: [formId], references: [id])
  facultyId String?
  faculty   Faculty?     @relation(fields: [facultyId], references: [id])
  role      String
  officeId  String
  office    Office       @relation(fields: [officeId], references: [id])
  priority  Int          @default(0)
  noteBg    String?
  noteEn    String?
}

model Submission {
  id             String       @id @default(cuid())
  ticketId       String       @unique
  formId         String
  form           FormTemplate @relation(fields: [formId], references: [id])
  officeId       String
  office         Office       @relation(fields: [officeId], references: [id])
  role           String
  facultyCode    String
  submitterName  String
  submitterEmail String
  dataJson       String
  status         String       @default("received")
  statusNoteBg   String?
  statusNoteEn   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile          Profile?
  casesOwned       Case[]           @relation("CaseOwner")
  stepsAssigned    CaseStep[]       @relation("StepAssignee")
  events           CaseEvent[]
  offeringsTaught  CourseOffering[] @relation("OfferingLecturer")
  offeringsAssisted CourseOffering[] @relation("OfferingAssistant")
  enrollments      Enrollment[]
  electiveChoices  ElectiveChoice[]
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String   // student | lecturer | program_admin | faculty_admin | admin_staff | applicant
  facultyId  String?
  faculty    Faculty? @relation(fields: [facultyId], references: [id])
  department String?  // department / program
  year       Int?     // for students
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProcessDefinition {
  id            String   @id @default(cuid())
  slug          String   @unique
  titleBg       String
  titleEn       String
  descriptionBg String
  descriptionEn String
  // comma-separated roles that may start this process (default deny)
  rolesAllowed  String
  templatePath  String?
  catalogCode   String?
  hub           String   @default("other")
  family        String?
  wizardKind    String   @default("dynamic")
  fieldsJson    String   @default("[]")
  routeJson     String   @default("[]")
  driveFileId   String?
  sourceFolder  String?
  nomenclatura  String?
  active        Boolean  @default(true)
  cases         Case[]
  createdAt     DateTime @default(now())
}

model Case {
  id          String            @id @default(cuid())
  number      String            @unique
  title       String
  status      String            // draft | awaiting_lecturer | awaiting_admin_review | awaiting_approvals | ready_for_rector | archived
  processId   String
  process     ProcessDefinition @relation(fields: [processId], references: [id])
  ownerId     String
  owner       User              @relation("CaseOwner", fields: [ownerId], references: [id])
  facultyId   String?
  faculty     Faculty?          @relation(fields: [facultyId], references: [id])
  metaJson    String            @default("{}")
  arhimedNo   String?
  docPath     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  steps       CaseStep[]
  events      CaseEvent[]
  loadReport  LoadReport?
}

model CaseStep {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  key          String   // e.g. confirm_hours, admin_review, legal, pfc, rector
  titleBg      String
  titleEn      String
  status       String   @default("pending") // pending | waiting | done | skipped
  assigneeId   String?
  assignee     User?    @relation("StepAssignee", fields: [assigneeId], references: [id])
  dueAt        DateTime?
  payloadJson  String   @default("{}")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String
  messageBg String
  messageEn String
  metaJson  String   @default("{}")
  createdAt DateTime @default(now())
}

model LoadReport {
  id            String     @id @default(cuid())
  caseId        String     @unique
  case          Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  periodLabel   String
  programName   String
  fundingSource String
  currency      String     @default("EUR")
  totalAmount   Float      @default(0)
  docPath       String?
  lines         LoadLine[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model LoadLine {
  id           String     @id @default(cuid())
  reportId     String
  report       LoadReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lecturerName String
  lecturerEmail String?
  activity     String     // lectures | exercises | exams | consultations | other
  hours        Float
  rateEur      Float
  amountEur    Float
  confirmed    Boolean    @default(false)
  note         String?
  sortOrder    Int        @default(0)
}

model TemplateAsset {
  id          String   @id @default(cuid())
  code        String   @unique
  titleBg     String
  titleEn     String
  path        String
  driveFileId String?
  notes       String?
  createdAt   DateTime @default(now())
}

model HandbookEntry {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleBg     String
  titleEn     String
  summaryBg   String
  summaryEn   String
  kind        String
  driveFileId String?
  path        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

// --- Academic / teaching desk ---

model Program {
  id                    String              @id @default(cuid())
  code                  String              @unique
  slug                  String              @unique
  titleBg               String
  titleEn               String
  degree                String
  professionalFieldBg   String?
  professionalFieldEn   String?
  facultyId             String
  faculty               Faculty             @relation(fields: [facultyId], references: [id])
  formOfStudy           String              @default("full-time")
  semesters             Int                 @default(8)
  noteBg                String?
  noteEn                String?
  versions              CurriculumVersion[]
  createdAt             DateTime            @default(now())
}

model CurriculumVersion {
  id              String             @id @default(cuid())
  programId       String
  program         Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear    String
  labelBg         String
  labelEn         String
  active          Boolean            @default(true)
  courses         CurriculumCourse[]
  offerings       CourseOffering[]
  electiveWindows ElectiveWindow[]
  createdAt       DateTime           @default(now())

  @@unique([programId, academicYear])
}

model CurriculumCourse {
  id            String           @id @default(cuid())
  versionId     String
  version       CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  code          String
  titleBg       String
  titleEn       String
  type          String
  semester      Int
  ects          Float
  hoursTotal    Int
  hoursLectures Int              @default(0)
  hoursSeminars Int              @default(0)
  hoursPractice Int              @default(0)
  weeklyLoad    String
  grading       String
  language      String           @default("bg")
  sortOrder     Int              @default(0)
  offerings     CourseOffering[]
  createdAt     DateTime         @default(now())

  @@unique([versionId, code, semester])
}

model CourseOffering {
  id             String           @id @default(cuid())
  slug           String           @unique
  courseId       String
  course         CurriculumCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionId      String
  version        CurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  academicYear   String
  term           String
  lecturerId     String?
  lecturer       User?            @relation("OfferingLecturer", fields: [lecturerId], references: [id])
  assistantId    String?
  assistant      User?            @relation("OfferingAssistant", fields: [assistantId], references: [id])
  room           String?
  language       String           @default("bg")
  assessmentForm String?
  studentCount   Int              @default(0)
  kind           String           @default("regular")
  yearOfStudy    Int?
  formOfStudy    String           @default("full-time")
  examined       Int              @default(0)
  currentAssessed Int             @default(0)
  courseworks    Int              @default(0)
  slots          ScheduleSlot[]
  syllabus       Syllabus?
  enrollments    Enrollment[]
  electiveChoices ElectiveChoice[]
  createdAt      DateTime         @default(now())
}

model ScheduleSlot {
  id           String        @id @default(cuid())
  offeringId   String
  offering     CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  weekday      Int
  startMinutes Int
  endMinutes   Int
  kind         String
  room         String?
}

model Syllabus {
  id               String         @id @default(cuid())
  offeringId       String         @unique
  offering         CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  annotationBg     String
  annotationEn     String
  prerequisitesBg  String?
  prerequisitesEn  String?
  outcomesBg       String?
  outcomesEn       String?
  gradingJson      String
  loadJson         String
  topicsJson       String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Enrollment {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  studentId  String
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     String         @default("enrolled")
  source     String         @default("compulsory")
  createdAt  DateTime       @default(now())

  @@unique([offeringId, studentId])
}

model ElectiveWindow {
  id           String             @id @default(cuid())
  slug         String             @unique
  versionId    String
  version      CurriculumVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  semester     Int
  academicYear String
  term         String
  opensAt      DateTime
  closesAt     DateTime
  minEcts      Float              @default(0)
  maxEcts      Float              @default(6)
  titleBg      String
  titleEn      String
  choices      ElectiveChoice[]
  createdAt    DateTime           @default(now())
}

model ElectiveChoice {
  id         String         @id @default(cuid())
  windowId   String
  window     ElectiveWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  studentId  String
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([windowId, studentId, offeringId])
}
